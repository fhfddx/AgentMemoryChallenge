# MASM 环境变量示例。
# 复制为 .env 后填入真实值；密钥只通过环境变量注入，绝不进入源码或日志。

# 数据库连接串（示例，勿提交真实凭据）
DATABASE_URL=postgresql+psycopg://masm:masm@localhost:5432/masm

# Compose 数据库配置（本地默认值仅用于开发；提交/部署前必须更换）
POSTGRES_DB=masm
POSTGRES_USER=masm
POSTGRES_PASSWORD=change-me

# 允许的 API Key，逗号分隔（Bearer / Token / X-Api-Key 共用）
MASM_API_KEYS=change-me

# 本地兼容对象目录；容器中挂载命名卷，生产环境应挂载受管持久卷。
MASM_ASSET_DIR=artifacts/assets

# 载荷与响应限制（字节）
MASM_MAX_IMAGE_BYTES=10485760
MASM_MAX_ADD_IMAGE_BYTES=31457280
MASM_MAX_SEARCH_RESPONSE_BYTES=31457280
MASM_MAX_TOP_K=100

# 运行档位：本地开发默认 local-fake；正式候选改为 official-baseline 或 official-masm。
MASM_RUNTIME_PROFILE=local-fake

# 正式模型 Provider。占位域名和密钥不可直接使用，也不要把真实值提交到仓库。
MASM_LLM_BASE_URL=https://llm-provider.invalid/v1
MASM_LLM_API_KEY=change-me
MASM_LLM_MODEL=gpt-4o-mini
MASM_EMBEDDING_BASE_URL=https://embedding-provider.invalid/v1
MASM_EMBEDDING_API_KEY=change-me
MASM_EMBEDDING_MODEL=text-embedding-v4
MASM_EMBEDDING_DIMENSIONS=1024
MASM_MODEL_TIMEOUT_SECONDS=30
MASM_MODEL_MAX_ATTEMPTS=2
